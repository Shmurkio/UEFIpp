<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UEFIpp">
    <UEFIppTraceModule Condition="'$(UEFIppTraceModule)'==''">$(ProjectName)</UEFIppTraceModule>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>UEFIPP_TRACE_MODULE=$(UEFIppTraceModule);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
